# --- Client data must never enter this public repository (see brief section 10) ---
# Model and export formats. Test fixtures are synthetic geometry generated by the
# tool, or a deliberately fictional sample building committed on purpose with an
# explicit override below.
*.ifc
*.ifczip
*.pln
*.pla
*.mod
*.3dm
*.gh
*.ghx
*.dwg
*.rvt
outputs/

# Deliberate exceptions: fictional fixtures, committed on purpose.
!tests/fixtures/**/*.ifc

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
