# --- Client data must never enter this public repository (see brief section 10) ---
# Model and export formats. Test fixtures are synthetic geometry generated by the
# tool, or a deliberately fictional sample building committed on purpose with an
# explicit override below.
*.ifc
*.ifczip
*.pln
*.pla
*.mod
*.3dm
*.gh
*.ghx
*.dwg
*.rvt
outputs/

# Deliberate exceptions: fictional fixtures, committed on purpose.
!tests/fixtures/**/*.ifc

# Reference material read while building, from real projects: a consultant's
# study pages, and the diagnostic dump archicad-report writes -- which names
# the project's file path, its layers and its zone names in full. Kept locally
# because the work needs them; never committed, because a public repository is
# the one place they must not be.
examples/
sun-study-info.txt

# Screenshots handed over to show a defect. They are pictures of a real
# project's Archicad session -- its name, its file path, its layout book --
# and they are read once and never wanted again.
problems/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
